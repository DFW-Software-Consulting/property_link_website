# Emmut public CMS API origin that powers the Long-Term Rentals pages.
# Defaults to production (https://emmut.dfwsc.com); override for local dev,
# e.g. CMS_API_URL=http://localhost:3000
# CMS_API_URL=

# Contact-form email notifications (optional).
# See lib/email/mailer.ts for which vars must be set together.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO=
# CONTACT_FROM=
