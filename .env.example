# Copy this file to .env and adjust values for your environment.

# PostgreSQL connection string used by Prisma and the Next.js app.
# Matches docker-compose.yml (host port 5434 -> container 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/property_link?schema=public"

# ---------------------------------------------------------------------------
# SMTP transport (shared by the contact form + maintenance request emails).
# All four are required together to enable sending; if any are missing the
# app still runs and just skips email. Gmail/Workspace: use an App Password
# with smtp.gmail.com:465.
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="no-reply@propertylinknyc.com"
SMTP_PASS="your-app-password"

# ---------------------------------------------------------------------------
# Contact form notifications.
# ---------------------------------------------------------------------------
CONTACT_TO="info@propertylinknyc.com"
CONTACT_FROM="PropertyLink NYC <no-reply@propertylinknyc.com>"

# ---------------------------------------------------------------------------
# Maintenance Request intake (emails one submission per request to a Google
# Workspace mailbox that the property-management app polls).
# ---------------------------------------------------------------------------
# MUST be byte-for-byte identical to the value in the property-management app,
# or every submission is silently rejected. Generate: openssl rand -hex 32
MAINTENANCE_INTAKE_SHARED_SECRET="replace-with-a-long-random-shared-secret"
# Workspace intake mailbox the property-management app polls.
MAINTENANCE_MAILBOX="maintenance@propertylinknyc.com"
# Stable sender the ingest filters on — do NOT change casually.
FORM_FROM_ADDRESS="PropertyLink Maintenance <no-reply@propertylinknyc.com>"

# ---------------------------------------------------------------------------
# CAPTCHA — Cloudflare Turnstile (verified server-side before sending).
# Site key is public (browser); secret key is server-only and never exposed.
# Dev: the values below are Cloudflare's always-pass TEST keys.
# Prod: replace both with real keys from the Cloudflare dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
